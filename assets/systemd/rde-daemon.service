[Unit]
Description=Riju Desktop Environment - Session Daemon
Documentation=https://github.com/rijum8906/rde
After=dbus.socket
Requires=dbus.socket
PartOf=graphical-session.target
Before=graphical-session.target
ConditionUser=!@system
Wants=graphical-session-pre.target

[Service]
Type=simple
NotifyAccess=none
ExecStart=/usr/bin/rde-daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# Sandboxing. The daemon spawns services and writes logs under the user's
# home (~/.local/rde/logs), so it needs write access there, but it does not
# need a network socket, kernel tuning, or write access to /usr.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=default.target
