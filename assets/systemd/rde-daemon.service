[Unit]
Description=Riju Desktop Environment - Session Daemon
Documentation=man:rde-daemon(1)
After=dbus.socket
Requires=dbus.socket
PartOf=graphical-session.target
Before=graphical-session.target
ConditionUser=!@system
Wants=graphical-session-pre.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/rde-daemon
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/usr/bin/rde-daemon --stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# Sandboxing. The daemon spawns services and reads ~/.config, so it needs
# the user's home; it doesn't need a network socket, and it doesn't need
# write access to /usr.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-write
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=default.target
