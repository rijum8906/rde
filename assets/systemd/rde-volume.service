[Unit]
Description=Riju Desktop Environment - Audio Volume Service
Documentation=https://github.com/rijum8906/rde
After=dbus.socket
Requires=dbus.socket
PartOf=graphical-session.target

# Optional standalone unit. rde-daemon detects the installed binary and
# spawns it itself; enable this only when running without the supervisor.

[Service]
Type=simple
ExecStart=/usr/bin/rde-volume
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
